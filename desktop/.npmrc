# npm 源与二进制镜像（默认走国内 npmmirror，便于国内网络安装）
# 想用官方源：删掉本文件，或 `npm install --registry=https://registry.npmjs.org/`

# 1) npm 包本身（含 ffprobe-static，其二进制随 tar 包发布，走 registry 即可）
registry=https://registry.npmmirror.com/

# 2) Electron 运行时二进制（electron 包的 postinstall 读取 electron_mirror）
electron_mirror=https://registry.npmmirror.com/-/binary/electron/

# 3) electron-builder 打包时下载的工具链（app-builder / nsis / winCodeSign 等）
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/

# 注：ffmpeg-static 的二进制下载地址由环境变量 FFMPEG_BINARIES_URL 控制，
# 无法通过 .npmrc 注入。它的镜像由本项目 postinstall（scripts/fetch-binaries.js）负责。
fund=false
audit=false
